# =============================================================
#   IT-TRACKER — Fichier de configuration d'environnement
#   Copiez ce fichier en .env et renseignez les valeurs.
#   ATTENTION : Ne commitez JAMAIS le fichier .env sur git.
# =============================================================

# --- Connexion à OpenCVE ---
# URL interne du serveur OpenCVE (dans le réseau Docker)
OPENCVE_URL=http://opencve-webserver:8000/opencve

# Identifiants du compte API OpenCVE dédié (créé par deploy-all.sh)
OPENCVE_USER=api_admin
OPENCVE_PASSWORD=your_opencve_api_password_here

# Token d'API optionnel (Bearer), si configuré dans OpenCVE
OPENCVE_TOKEN=

# --- Compte administrateur IT-Tracker ---
TRACKER_ADMIN_USER=admin
TRACKER_ADMIN_PASSWORD=your_secure_admin_password_here

# --- Base de données (optionnel, chemin par défaut : backend/database.db) ---
# DB_PATH=/app/backend/data/tracker.db

# --- Intégration Uptime Kuma ---
ENABLE_UPTIME_KUMA=true

# --- Intégration Vigil365 (M365 Security Alert Dashboard) ---
ENABLE_VIGIL365=true
VIGIL365_TENANT_ID=YOUR_TENANT_ID
VIGIL365_CLIENT_ID=YOUR_CLIENT_ID
VIGIL365_CLIENT_SECRET=YOUR_CLIENT_SECRET
